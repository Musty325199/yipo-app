{
  "expo": {
    "name": "Yípo",
    "slug": "yipo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yipo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musty.yipo"
    },
    "android": {
      "package": "com.musty.yipo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#10241E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10241E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F0B429"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yípo to select payment receipt photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Yípo to use Face ID for app lock."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Yípo reads your contacts only so you can pick members. They stay on your phone."
        }
      ],
      "./plugins/withAndroidArchitectures",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["image/*"],
          "androidMultiIntentFilters": ["image/*"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "037b2141-56e2-4621-96d7-9feb4b6d3655"
      }
    }
  }
}
